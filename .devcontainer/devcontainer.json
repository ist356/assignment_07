{
  "name": "IST356 Assignment 07",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "sudo python -m playwright install-deps && python -m playwright install chromium",
  "forwardPorts": [8888, 8501],
  "portsAttributes": {
    "8888": { "label": "Jupyter" },
    "8501": { "label": "Streamlit" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
